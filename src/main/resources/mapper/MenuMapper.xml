    <update id="deleteMenu" parameterType="java.lang.Long">
        UPDATE menu
        SET del_flag = 1
        WHERE id = #{id}
    </update>

    <update id="updateOrderNumBatch">
        <foreach collection="menus" item="menu" separator=";">
            UPDATE menu
            SET order_num = #{menu.orderNum}
            WHERE id = #{menu.id}
        </foreach>
    </update>


</mapper>
