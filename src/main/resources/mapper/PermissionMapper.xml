<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huiyi.huiyiproject.mapper.PermissionMapper">

    <resultMap id="BaseResultMap" type="com.huiyi.huiyiproject.entity.Permission">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="INTEGER"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="resourceId" column="resource_id" jdbcType="BIGINT"/>
            <result property="resourceType" column="resource_type" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,create_time,update_time
        ,del_flag,name,description
        ,resource_id,resource_type
    </sql>

    <!-- 根据资源 ID 和类型查询权限 -->
    <select id="selectByResourceIdAndType" resultType="com.huiyi.huiyiproject.entity.Permission">
        SELECT
            <include refid="Base_Column_List"/>
        FROM
            permission
        WHERE
            resource_id = #{resourceId}
            AND resource_type = #{resourceType}
    </select>


    <update id="deleteByResourceIdAndType">
        UPDATE permission
        SET del_flag = 1
        WHERE resource_id = #{resourceId}
          AND resource_type = #{resourceType}
    </update>


</mapper>
